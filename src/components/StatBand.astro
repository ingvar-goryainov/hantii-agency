---
/** StatBand (FR-05): the four approved figures on surface-deep, overlapping the hero. */
import { stats } from "../data/site";
---

<section class="stats-wrap" aria-labelledby="stats-title">
  <div class="container">
    <h2 id="stats-title" class="visually-hidden">{stats.heading}</h2>
    <dl class="hn-stats panel-deep on-deep">
      {stats.items.map((item) => (
        <div class="hn-stat">
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .stats-wrap {
    position: relative;
    z-index: 1;
    margin-top: calc(-1 * var(--space-6));
  }
  .hn-stats {
    padding: var(--space-7) var(--space-6);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .hn-stat {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    text-align: center;
  }
  .hn-stat + .hn-stat { border-left: 1px solid var(--line-deep); }
  dd {
    order: -1;
    font: 300 clamp(48px, 40.4px + 2.04vw, 64px) / 1 var(--font-display);
    letter-spacing: -.02em;
    color: var(--ink-inverse);
    font-variant-numeric: tabular-nums;
  }
  dt {
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink-inverse-muted);
    padding-inline: var(--space-2);
  }

  @media (max-width: 860px) {
    .hn-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--space-6); }
    .hn-stat + .hn-stat:nth-child(odd) { border-left: 0; }
  }
  @media (max-width: 640px) {
    .hn-stats { padding: var(--space-6) var(--space-4); column-gap: var(--space-3); }
  }
</style>
