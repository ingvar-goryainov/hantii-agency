---
/**
 * Hantii button (design system "Button"). Labels are written in sentence case in content and
 * uppercased by CSS. One primary per section; never a ghost button on surface-deep.
 * Renders an <a> with `href`, otherwise a <button>.
 */
import type { HTMLAttributes } from "astro/types";
import Icon from "./Icon.astro";

type Props = Omit<HTMLAttributes<"a">, "type"> & {
  href?: string;
  type?: "button" | "submit";
  variant?: "primary" | "ghost";
  size?: "small";
  /** Trailing arrow that nudges right on hover. */
  arrow?: boolean;
};

const { href, type = "button", variant = "primary", size, arrow = false, class: className, ...rest } = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  type={href ? undefined : type}
  class:list={["hn-btn", `hn-btn--${variant}`, size === "small" && "hn-btn--small", className]}
  {...rest}
><slot />{arrow && <Icon name="arrow-right" size={16} class="hn-btn-arrow" />}</Tag>
