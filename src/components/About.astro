---
/**
 * About us (FR-18): who we are, the industries we recruit for as chips, and a 2×2 grid of
 * industry pictures beside them (under the chips ≤ 860px). The pictures are decorative, since
 * the chips name the industries; hovering a chip highlights its picture, and the other way round.
 */
import { Picture } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import { about, domain } from "../data/site";

// Never upscale: small pictures get their own width as the largest candidate.
const widths = (w: number) => [...new Set([240, 480, 720].filter((x) => x < w).concat(Math.min(720, w)))];
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container layout">
    <div>
      <SectionHeading heading={about} id="about-title" />
      <ul class="chips">
        {domain.industries.map((industry) => <li>{industry.label}</li>)}
      </ul>
    </div>
    <div class="pictures" aria-hidden="true">
      {domain.industries.map(({ picture }) => (
        <div class="frame">
          <Picture
            src={picture}
            alt=""
            formats={["avif", "webp"]}
            widths={widths(picture.width)}
            width={Math.min(720, picture.width)}
            sizes="(max-width: 860px) min(calc(50vw - 22px), 352px), 212px"
            loading="lazy"
            class="picture"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    align-items: center;
    gap: var(--space-8);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }
  .chips li {
    padding: 10px var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface-mist);
    color: var(--ink);
    font: 600 14px/1.2 var(--font-label);
    transition: border-color .2s, color .2s;
  }

  .pictures {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .frame {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    isolation: isolate;
    background: var(--surface-mist);
    transition: border-color .2s;
  }
  .frame :global(picture),
  .frame :global(.picture) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A chip and its picture highlight together, whichever is hovered: one rule per industry. */
  .layout:has(:is(.chips li, .frame):nth-child(1):hover) :is(.chips li, .frame):nth-child(1),
  .layout:has(:is(.chips li, .frame):nth-child(2):hover) :is(.chips li, .frame):nth-child(2),
  .layout:has(:is(.chips li, .frame):nth-child(3):hover) :is(.chips li, .frame):nth-child(3),
  .layout:has(:is(.chips li, .frame):nth-child(4):hover) :is(.chips li, .frame):nth-child(4) {
    --zoom: 1.04;
    border-color: var(--violet-600);
    color: var(--violet-600);
  }
  @media (prefers-reduced-motion: no-preference) {
    .frame :global(.picture) {
      transform: scale(var(--zoom, 1));
      transition: transform .5s ease;
    }
  }

  @media (max-width: 860px) {
    .layout { grid-template-columns: minmax(0, 1fr); gap: var(--space-7); }
    .pictures { max-width: 720px; }
  }
  @media (max-width: 640px) {
    .pictures { gap: var(--space-3); }
  }
</style>
