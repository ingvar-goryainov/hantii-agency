---
/**
 * Hiring Advisory (FR-22): four service cards on the mist ground. The first three are numbered
 * steps (diagnosis → plan → implementation); the fourth carries an "Add-on" badge and a dashed
 * border, since it is optional. The section's one primary button sits under the grid.
 */
import Button from "./Button.astro";
import SectionHeading from "./SectionHeading.astro";
import { advisory } from "../data/site";

const steps = advisory.services.filter((s) => !s.addOn).length;
---

<section id="advisory" class="section section--mist" aria-labelledby="advisory-title">
  <div class="container">
    <SectionHeading heading={advisory} id="advisory-title" />
    <ul class="grid">
      {advisory.services.map((s, i) => (
        <li class:list={["card", s.addOn && "card--addon"]}>
          {s.addOn
            ? <span class="hn-badge hn-badge--outline">{advisory.addOn}</span>
            : <span class="step t-eyebrow">{String(i + 1).padStart(2, "0")} / {String(steps).padStart(2, "0")}</span>}
          <h3 class="t-card-title">{s.title}</h3>
          <p class="headline">{s.headline}</p>
          <p class="t-body">{s.body}</p>
        </li>
      ))}
    </ul>
    <Button href={advisory.cta.href} arrow class="cta">{advisory.cta.label}</Button>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-7);
  }
  .card { display: grid; align-content: start; justify-items: start; gap: var(--space-3); }
  .card--addon { border-style: dashed; border-color: var(--line-strong); }
  .step { display: block; min-height: 32px; padding-top: 10px; color: var(--aqua-700); }
  .card .hn-badge { min-height: 32px; }
  h3 { color: var(--ink); margin-top: var(--space-2); }
  .headline { font: 600 16px/1.45 var(--font-body); color: var(--ink); }
  .t-body { color: var(--ink-muted); }
  .container :global(.cta) { margin-top: var(--space-7); }

  @media (max-width: 1100px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
