---
/**
 * Team member card (FR-09, FR-19): a 4:5 portrait with the name and role either over a
 * surface-deep gradient with a LinkedIn button (founders) or under the photo, so the photo
 * stays whole (team). Without a photo it shows the placeholder state.
 */
import { Picture } from "astro:assets";
import Gem from "./Gem.astro";
import Icon from "./Icon.astro";
import type { TeamMember } from "../data/site";

interface Props {
  member: TeamMember;
  photoPending: string;
  /** "overlay": name and role over the photo; "below": under it. */
  caption?: "overlay" | "below";
  /** `sizes` for the portrait's srcset, matching the grid the card sits in. */
  sizes: string;
}

const { member, photoPending, caption = "overlay", sizes } = Astro.props;
const { photo } = member;
// Never upscale: small portraits get their own width as the largest candidate.
const widths = photo
  ? [...new Set([320, 480, 640].filter((w) => w < photo.width).concat(Math.min(640, photo.width)))]
  : [];
---

<article class:list={["member", `member--${caption}`, !photo && "member--pending"]}>
  <div class="frame">
    {photo ? (
      <Picture
        src={photo}
        alt={member.alt ?? `Portrait of ${member.name}`}
        formats={["avif", "webp"]}
        widths={widths}
        width={Math.min(640, photo.width)}
        sizes={sizes}
        loading="lazy"
        class="photo"
      />
    ) : (
      <div class="pending">
        <Gem size={64} />
        <p class="t-caption">{photoPending}</p>
      </div>
    )}
  </div>
  <div class:list={["caption", caption === "overlay" && photo && "on-deep"]}>
    <div class="who">
      <h3 class="t-card-title name">{member.name}</h3>
      <p class="t-eyebrow role">{member.role}</p>
    </div>
    {member.linkedin && (
      <a class="linkedin" href={member.linkedin} aria-label={`${member.name} on LinkedIn`} rel="noopener">
        <Icon name="linkedin" size={20} />
      </a>
    )}
  </div>
</article>

<style>
  .member { position: relative; }
  .frame {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    isolation: isolate;
    background: var(--surface-mist);
  }
  .frame :global(picture),
  .frame :global(.photo) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .frame :global(.photo) { transition: transform .5s ease; }
  @media (prefers-reduced-motion: no-preference) {
    .member:hover .frame :global(.photo) { transform: scale(1.04); }
  }

  .who { display: grid; gap: var(--space-2); }

  /* Overlay (founders): name and role over a surface-deep gradient at the bottom of the photo. */
  .member--overlay { border-radius: var(--radius-lg); overflow: hidden; isolation: isolate; }
  .member--overlay .caption {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-5) var(--space-5);
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--surface-deep) 92%, transparent),
      color-mix(in srgb, var(--surface-deep) 0%, transparent)
    );
  }
  .member--overlay .name { color: var(--ink-inverse); }
  .member--overlay .role { color: var(--emerald-300); }

  .linkedin {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    border: 1px solid var(--line-deep);
    background: var(--surface-deep-raised);
    color: var(--ink-inverse);
    transition: border-color .2s;
  }
  .linkedin:hover { border-color: var(--violet-300); }

  /* Below (team): the photo stays whole; name and role sit under it, LinkedIn beside them. */
  .member--below .caption {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-4);
  }
  .member--below .who { min-width: 0; }
  .member--below .name { font-size: 20px; color: var(--ink); }
  .member--below .role { color: var(--aqua-700); line-height: 1.4; }

  /* Placeholder state: gem on a mist-to-blush ground, name and role in ink. */
  .member--pending .frame {
    display: grid;
    background: linear-gradient(160deg, var(--surface-mist), var(--surface-blush));
    border: 1px solid var(--line);
  }
  .pending {
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--space-4);
    color: var(--ink-muted);
  }
  .member--overlay.member--pending .pending { padding-bottom: var(--space-9); }
  .member--overlay.member--pending .caption { background: none; }
  .member--overlay.member--pending .name { color: var(--ink); }
  .member--overlay.member--pending .role { color: var(--aqua-700); }
  /* On light grounds the LinkedIn button is light too. */
  .member--below .linkedin,
  .member--pending .linkedin {
    border-color: var(--line);
    background: var(--surface);
    color: var(--ink);
  }
  .member--below .linkedin:hover,
  .member--pending .linkedin:hover { border-color: var(--violet-600); }
</style>
