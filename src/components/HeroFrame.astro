---
/**
 * HeroFrame (FR-04): the hantii.pdf blob behind a thin browser window. Geometry is copied from
 * the design system; keep the viewBox and shapes exactly (docs/design.md §7.6). The window holds
 * a snapshot of the talent pipeline as HTML laid over the window area, so it can reflow:
 * role titles only, never candidate names.
 */
import { hero } from "../data/site";

const { pipeline } = hero;
---

<figure class="hero-frame">
  <div class="stage">
    <svg class="hn-frame" viewBox="436 208 284 250" aria-hidden="true" focusable="false">
      <path class="blob" d="M 634.039062 348.203125 L 674.246094 314.117188 L 675.871094 312.851562 C 699.273438 294.363281 714.417969 269.9375 709.125 250.265625 C 705.558594 237.039062 695.824219 221.09375 674.304688 219.589844 L 515.527344 216.128906 C 499.921875 215.039062 486.695312 217.140625 481.203125 230.714844 C 479.917969 233.894531 479.253906 237.292969 479.253906 240.726562 C 479.238281 260.105469 535.214844 272.3125 535.121094 294.503906 C 534.992188 326.699219 462.867188 362.847656 462.570312 400.964844 C 462.480469 412.628906 463.597656 418.386719 468.394531 426.042969 C 473.929688 434.875 493.507812 439.375 501.550781 440.222656 L 634.707031 452.128906 C 647.089844 452.996094 655.777344 447.855469 658.863281 438.597656 C 662.285156 428.335938 657.648438 420.929688 653.21875 417.65625 L 624.429688 397.441406 C 618.515625 393.269531 614.128906 390.152344 611.277344 388.097656 C 604.1875 382.304688 604.808594 374.542969 613.164062 368.707031 Z M 634.039062 348.203125 "></path>
      <rect class="frame" x="442.34" y="237.66" width="251.8" height="185.26" rx="3.6"></rect>
      <line class="frame-line" x1="442.34" y1="258.86" x2="694.14" y2="258.86"></line>
      <circle class="dot-a" cx="454.63" cy="248.91" r="2.75"></circle>
      <circle class="dot-b" cx="464.38" cy="248.91" r="2.75"></circle>
      <circle class="dot-c" cx="474.55" cy="248.91" r="2.75"></circle>
    </svg>

    <div class="window">
      <div class="window-inner">
        <p class="label" id="pipeline-label">{pipeline.label}</p>
        <div class="cols" aria-hidden="true">
          <span>{pipeline.columns.role}</span>
          <span>{pipeline.columns.status}</span>
        </div>
        <ul class="rows" aria-labelledby="pipeline-label" aria-describedby="pipeline-note">
          {pipeline.roles.map((role) => (
            <li>
              <span class="role">{role}</span>
              <span class="pill"><span class="pulse"></span>{pipeline.status}</span>
            </li>
          ))}
        </ul>
        <p class="note" id="pipeline-note">{pipeline.caption}</p>
      </div>
    </div>
  </div>
</figure>

<style>
  .stage { position: relative; }
  .hn-frame { width: 100%; height: auto; overflow: visible; }
  .blob { fill: var(--surface-blush); }
  .frame { fill: var(--surface); stroke: var(--ink); stroke-width: .55; }
  .frame-line { stroke: var(--ink); stroke-width: .45; }
  .dot-a { fill: var(--emerald-500); }
  .dot-b { fill: var(--ink); }
  .dot-c { fill: var(--violet-600); }

  /* The window's content area in viewBox terms: x 442.34–694.14, y 258.86–422.92.
     Everything inside is sized in cqi of this box, so it scales with the drawing. */
  .window {
    position: absolute;
    left: 2.2324%;
    top: 20.344%;
    width: 88.662%;
    height: 65.624%;
    overflow: hidden;
    container-type: inline-size;
  }
  .window-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 3.6cqi 4.4cqi;
  }

  .label {
    font: 700 min(12px, 3cqi) / 1 var(--font-label);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--aqua-700);
    margin-bottom: 2.8cqi;
  }
  .cols {
    display: flex;
    justify-content: space-between;
    padding-bottom: 1.6cqi;
    font: 700 min(11px, 2.7cqi) / 1 var(--font-label);
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .rows li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.4cqi;
    padding-block: 2.2cqi;
    border-top: 1px solid var(--line);
  }
  .role {
    font: 600 min(16px, 3.9cqi) / 1.25 var(--font-display);
    color: var(--ink);
  }
  .pill {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: .5em;
    padding: .4em .8em;
    border-radius: var(--radius-pill);
    background: var(--emerald-100);
    color: var(--emerald-800);
    font: 700 min(11px, 2.7cqi) / 1 var(--font-label);
    letter-spacing: .04em;
    white-space: nowrap;
  }
  .pulse {
    width: .6em;
    height: .6em;
    border-radius: 50%;
    background: var(--emerald-500);
  }
  /* The table's footer: pinned to the bottom of the window. */
  .note {
    margin-top: auto;
    padding-top: 2.2cqi;
    border-top: 1px solid var(--line);
    font: 400 min(13px, 3.2cqi) / 1.4 var(--font-body);
    color: var(--ink-muted);
  }

  /* Phones: each row stacks the pill under the role; the column header no longer applies.
     Sizes are tighter here so the rows and the footer fit the window at every width. */
  @container (max-width: 359px) {
    .window-inner { padding-block: 3cqi; }
    .cols { display: none; }
    .label { font-size: 3.3cqi; margin-bottom: 1.8cqi; }
    .rows li {
      flex-direction: column;
      align-items: flex-start;
      gap: .8cqi;
      padding-block: 1.2cqi;
    }
    .role { font-size: 4.2cqi; }
    .pill { font-size: 3.3cqi; padding: .35em .75em; }
    .note { font-size: 3.3cqi; line-height: 1.3; padding-top: 1.6cqi; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .blob {
      transform-box: fill-box;
      transform-origin: center;
      animation: drift 14s ease-in-out infinite;
    }
    @keyframes drift {
      0%, 100% { transform: rotate(-2deg); }
      50% { transform: rotate(2deg); }
    }
    /* Rows slide in once from a visible state: transform only, never hidden. */
    .rows li { animation: row-in .7s cubic-bezier(.2, .7, .2, 1) both; }
    .rows li:nth-child(2) { animation-delay: .12s; }
    .rows li:nth-child(3) { animation-delay: .24s; }
    @keyframes row-in {
      from { transform: translateX(-12px); }
    }
    .pulse { animation: pulse 2.8s ease-in-out infinite; }
    @keyframes pulse {
      0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--emerald-500) 45%, transparent); }
      60% { box-shadow: 0 0 0 .45em color-mix(in srgb, var(--emerald-500) 0%, transparent); }
    }
  }
</style>
