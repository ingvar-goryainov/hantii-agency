---
/** Footer (FR-11): mist ground, logo and blurb, agency links, contacts, copyright line. */
import Logo from "./Logo.astro";
import { contact, contacts, footer } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="about">
        <a class="brand" href="/#top" aria-label="Hantii — home"><Logo /></a>
        <p class="t-caption blurb">{footer.blurb}</p>
      </div>
      <nav aria-labelledby="footer-agency">
        <h2 id="footer-agency" class="t-eyebrow col-title">{footer.agencyTitle}</h2>
        <ul class="links">
          {footer.agency.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <h2 class="t-eyebrow col-title">{footer.contactsTitle}</h2>
        <ul class="links">
          <li><a href={footer.emailHref}>{contacts.email}</a></li>
          <li><a href={contacts.linkedin} rel="noopener">{contact.rows.linkedin}</a></li>
          <li><a href={contacts.instagram} rel="noopener">{contact.rows.instagram}</a></li>
        </ul>
      </div>
    </div>
    <div class="bottom t-caption">
      <p>{footer.copyright(year)}</p>
      <p>{footer.tagline}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-mist);
    padding-block: var(--space-8) var(--space-6);
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-7) var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--line);
  }
  .about { display: grid; justify-items: start; align-content: start; gap: var(--space-4); }
  .brand { display: block; border-radius: var(--radius-sm); }
  .blurb { max-width: 34em; color: var(--ink-muted); }
  .col-title { color: var(--aqua-700); margin-bottom: var(--space-2); }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font-size: 15px;
    text-decoration: none;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
    transition: color .2s;
  }
  .links a:hover {
    color: var(--violet-600);
    text-decoration-line: underline;
    text-decoration-color: var(--violet-600);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-top: var(--space-5);
    color: var(--ink-muted);
  }

  @media (max-width: 860px) {
    .top { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .about { grid-column: 1 / -1; }
  }
  @media (max-width: 400px) {
    .top { grid-template-columns: minmax(0, 1fr); }
  }
</style>
