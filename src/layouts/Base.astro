---
/** Page shell: head (meta, fonts, structured data), skip link, header, footer. */
import "../styles/tokens.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { contacts, site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = site.meta.title, description = site.meta.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImage = new URL("/og-image.png", site.url).toString();
const fonts =
  "https://fonts.googleapis.com/css2?family=Geologica:wght@300;400;600;700&family=Montserrat:wght@600;700&family=Open+Sans:wght@400;600;700&display=swap";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "EmploymentAgency",
  name: site.name,
  alternateName: site.legalName,
  url: `${site.url}/`,
  logo: `${site.url}/apple-touch-icon.png`,
  email: contacts.email,
  description: site.meta.description,
  sameAs: [contacts.linkedin, contacts.instagram],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#ffffff" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <noscript><style>[data-copy] { display: none !important; }</style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
