{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hantii",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "hantii.com", "custom_domain": true },
    { "pattern": "www.hantii.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  // Local `wrangler dev` would otherwise forward requests as the first route's host (hantii.com)
  // and the Worker would redirect them to production.
  "dev": { "ip": "127.0.0.1", "port": 8787, "host": "localhost" }
}
